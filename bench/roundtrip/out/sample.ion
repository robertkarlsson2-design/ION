// User service — same logic as JS / TS / Python samples

data User { id: Int, name: Str, email: Str, active: Bool, score: Int }

fn getActiveUsers(users: List<User>) -> List<User> =
  users |> filter(u -> u.active)

fn topScorers(users: List<User>, n: Int) -> List<User> =
  users
    |> filter(u -> u.active)
    |> sortBy(u -> u.score)
    |> reverse
    |> slice(0, n)

fn averageScore(users: List<User>) -> Int =
  if length(users) == 0 then 0
  else sum(users |> map(u -> u.score)) / length(users)

fn emailsFor(users: List<User>) -> List<Str> =
  users |> filter(u -> u.active) |> map(u -> u.email)
