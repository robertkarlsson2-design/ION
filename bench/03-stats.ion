pub fn total(ns: List<Int>) -> Int =
  fold(ns, 0, (acc, x) -> acc + x)

pub fn mean(ns: List<Int>) -> Int =
  total(ns) / length(ns)

pub fn maximum(ns: List<Int>) -> Int =
  fold(ns, 0, (acc, x) -> if x > acc then x else acc)

pub fn minimum(ns: List<Int>) -> Int =
  fold(ns, 999999, (acc, x) -> if x < acc then x else acc)

pub fn countIf(ns: List<Int>, pred: fn(Int) -> Bool) -> Int =
  length(filter(ns, pred))
