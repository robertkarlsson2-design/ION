pub fn wordCount(text) =
  text |> trim |> split(" ") |> filter(w -> w != "") |> length

pub fn capitalize(words) =
  words |> map(toUpper) |> joinWith(" ")

pub fn csvRow(fields) = joinWith(fields, ",")

pub fn hasKeyword(text, keyword) =
  toLower(text) |> split(" ") |> any(w -> w == toLower(keyword))
