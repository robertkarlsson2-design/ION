extern "javascript" {
  // --- primitive types ---
  type List<T> = "Array"
  type Option<T> = "($1 ?? null)"
  type Map<K, V> = "Map"
  type Result<T, E> = "($1)"
  type Pair<A, B> = "[$1, $2]"
  type Set<T> = "Set"

  // --- console ---
  fn console_log(msg: Str) !io = "console.log($1)"
  fn console_error(msg: Str) !io = "console.error($1)"
  fn console_warn(msg: Str) !io = "console.warn($1)"
  fn console_info(msg: Str) !io = "console.info($1)"
  fn console_debug(msg: Str) !io = "console.debug($1)"

  // --- Array (static) ---
  fn array_isArray(val: a) -> Bool = "Array.isArray($1)"
  fn array_from<T>(iterable: a) -> List<T> = "Array.from($1)"
  fn array_of<T>(val: T) -> List<T> = "Array.of($1)"

  // --- Array (prototype) ---
  fn push<T>(arr: List<T>, val: T) !io -> Int = "$1.push($2)"
  fn pop<T>(arr: List<T>) !io -> Option<T> = "$1.pop()"
  fn shift<T>(arr: List<T>) !io -> Option<T> = "$1.shift()"
  fn unshift<T>(arr: List<T>, val: T) !io -> Int = "$1.unshift($2)"
  fn at<T>(arr: List<T>, idx: Int) -> Option<T> = "$1.at($2)"
  fn slice<T>(arr: List<T>, start: Int, end_: Int) -> List<T> = "$1.slice($2, $3)"
  fn splice<T>(arr: List<T>, start: Int, deleteCount: Int) !io -> List<T> = "$1.splice($2, $3)"
  fn concat<T>(arr: List<T>, other: List<T>) -> List<T> = "$1.concat($2)"
  fn join<T>(arr: List<T>, sep: Str) -> Str = "$1.join($2)"
  fn sort<T>(arr: List<T>) !io -> List<T> = "$1.sort()"
  fn reverse<T>(arr: List<T>) !io -> List<T> = "$1.reverse()"
  fn indexOf<T>(arr: List<T>, val: T) -> Int = "$1.indexOf($2)"
  fn lastIndexOf<T>(arr: List<T>, val: T) -> Int = "$1.lastIndexOf($2)"
  fn includes<T>(arr: List<T>, val: T) -> Bool = "$1.includes($2)"
  fn find<T>(arr: List<T>, pred: fn(T) -> Bool) -> Option<T> = "$1.find($2)"
  fn findIndex<T>(arr: List<T>, pred: fn(T) -> Bool) -> Int = "$1.findIndex($2)"
  fn filter<T>(arr: List<T>, pred: fn(T) -> Bool) -> List<T> = "$1.filter($2)"
  fn map<T, U>(arr: List<T>, f: fn(T) -> U) -> List<U> = "$1.map($2)"
  fn reduce<T, U>(arr: List<T>, f: fn(U, T) -> U, init: U) -> U = "$1.reduce($2, $3)"
  fn forEach<T>(arr: List<T>, f: fn(T) -> Unit) !io = "$1.forEach($2)"
  fn every<T>(arr: List<T>, pred: fn(T) -> Bool) -> Bool = "$1.every($2)"
  fn some<T>(arr: List<T>, pred: fn(T) -> Bool) -> Bool = "$1.some($2)"
  fn flat<T>(arr: List<List<T>>) -> List<T> = "$1.flat()"
  fn flatMap<T, U>(arr: List<T>, f: fn(T) -> List<U>) -> List<U> = "$1.flatMap($2)"
  fn fill<T>(arr: List<T>, val: T) !io -> List<T> = "$1.fill($2)"
  fn copyWithin<T>(arr: List<T>, target: Int, start: Int) !io -> List<T> = "$1.copyWithin($2, $3)"
  fn array_entries<T>(arr: List<T>) -> a = "$1.entries()"
  fn array_keys<T>(arr: List<T>) -> a = "$1.keys()"
  fn array_values<T>(arr: List<T>) -> a = "$1.values()"
  fn length<T>(arr: List<T>) -> Int = "$1.length"

  // --- Object ---
  fn object_keys(obj: a) -> List<Str> = "Object.keys($1)"
  fn object_values<V>(obj: a) -> List<V> = "Object.values($1)"
  fn object_entries<V>(obj: a) -> List<Pair<Str, V>> = "Object.entries($1)"
  fn object_assign<T>(target: T, source: a) !io -> T = "Object.assign($1, $2)"
  fn object_create(proto: a) -> a = "Object.create($1)"
  fn object_freeze<T>(obj: T) -> T = "Object.freeze($1)"
  fn object_seal<T>(obj: T) -> T = "Object.seal($1)"
  fn object_fromEntries<V>(entries: a) -> a = "Object.fromEntries($1)"
  fn object_hasOwn(obj: a, key: Str) -> Bool = "Object.hasOwn($1, $2)"
  fn object_is(a_: a, b: a) -> Bool = "Object.is($1, $2)"
  fn object_getPrototypeOf(obj: a) -> a = "Object.getPrototypeOf($1)"

  // --- Promise (static) ---
  fn promise_resolve<T>(val: T) -> a = "Promise.resolve($1)"
  fn promise_reject(reason: a) -> a = "Promise.reject($1)"
  fn promise_all(promises: List<a>) !async -> List<a> = "Promise.all($1)"
  fn promise_allSettled(promises: List<a>) !async -> List<a> = "Promise.allSettled($1)"
  fn promise_race(promises: List<a>) !async -> a = "Promise.race($1)"
  fn promise_any(promises: List<a>) !async -> a = "Promise.any($1)"

  // --- Promise (prototype) ---
  fn promise_then<T, U>(p: a, onFulfilled: fn(T) -> U) !async -> a = "$1.then($2)"
  fn promise_catch(p: a, onRejected: fn(a) -> a) !async -> a = "$1.catch($2)"
  fn promise_finally(p: a, onFinally: fn() -> Unit) !async -> a = "$1.finally($2)"

  // --- String (static) ---
  fn string_fromCharCode(code: Int) -> Str = "String.fromCharCode($1)"
  fn string_raw(template: a) -> Str = "String.raw($1)"

  // --- String (prototype) ---
  fn str_length(s: Str) -> Int = "$1.length"
  fn str_charAt(s: Str, idx: Int) -> Str = "$1.charAt($2)"
  fn str_charCodeAt(s: Str, idx: Int) -> Int = "$1.charCodeAt($2)"
  fn str_at(s: Str, idx: Int) -> Option<Str> = "$1.at($2)"
  fn str_indexOf(s: Str, sub: Str) -> Int = "$1.indexOf($2)"
  fn str_lastIndexOf(s: Str, sub: Str) -> Int = "$1.lastIndexOf($2)"
  fn str_includes(s: Str, sub: Str) -> Bool = "$1.includes($2)"
  fn str_startsWith(s: Str, prefix: Str) -> Bool = "$1.startsWith($2)"
  fn str_endsWith(s: Str, suffix: Str) -> Bool = "$1.endsWith($2)"
  fn str_slice(s: Str, start: Int, end_: Int) -> Str = "$1.slice($2, $3)"
  fn str_substring(s: Str, start: Int, end_: Int) -> Str = "$1.substring($2, $3)"
  fn str_toUpperCase(s: Str) -> Str = "$1.toUpperCase()"
  fn str_toLowerCase(s: Str) -> Str = "$1.toLowerCase()"
  fn str_trim(s: Str) -> Str = "$1.trim()"
  fn str_trimStart(s: Str) -> Str = "$1.trimStart()"
  fn str_trimEnd(s: Str) -> Str = "$1.trimEnd()"
  fn str_split(s: Str, sep: Str) -> List<Str> = "$1.split($2)"
  fn str_replace(s: Str, search: Str, replacement: Str) -> Str = "$1.replace($2, $3)"
  fn str_replaceAll(s: Str, search: Str, replacement: Str) -> Str = "$1.replaceAll($2, $3)"
  fn str_match(s: Str, pattern: a) -> Option<a> = "$1.match($2)"
  fn str_padStart(s: Str, length: Int, fill: Str) -> Str = "$1.padStart($2, $3)"
  fn str_padEnd(s: Str, length: Int, fill: Str) -> Str = "$1.padEnd($2, $3)"
  fn str_repeat(s: Str, count: Int) -> Str = "$1.repeat($2)"
  fn str_codePointAt(s: Str, idx: Int) -> Option<Int> = "$1.codePointAt($2)"

  // --- Math ---
  fn math_abs(x: Float) -> Float = "Math.abs($1)"
  fn math_ceil(x: Float) -> Float = "Math.ceil($1)"
  fn math_floor(x: Float) -> Float = "Math.floor($1)"
  fn math_round(x: Float) -> Float = "Math.round($1)"
  fn math_max(a: Float, b: Float) -> Float = "Math.max($1, $2)"
  fn math_min(a: Float, b: Float) -> Float = "Math.min($1, $2)"
  fn math_pow(base: Float, exp: Float) -> Float = "Math.pow($1, $2)"
  fn math_sqrt(x: Float) -> Float = "Math.sqrt($1)"
  fn math_log(x: Float) -> Float = "Math.log($1)"
  fn math_log2(x: Float) -> Float = "Math.log2($1)"
  fn math_log10(x: Float) -> Float = "Math.log10($1)"
  fn math_exp(x: Float) -> Float = "Math.exp($1)"
  fn math_sin(x: Float) -> Float = "Math.sin($1)"
  fn math_cos(x: Float) -> Float = "Math.cos($1)"
  fn math_tan(x: Float) -> Float = "Math.tan($1)"
  fn math_asin(x: Float) -> Float = "Math.asin($1)"
  fn math_acos(x: Float) -> Float = "Math.acos($1)"
  fn math_atan(x: Float) -> Float = "Math.atan($1)"
  fn math_atan2(y: Float, x: Float) -> Float = "Math.atan2($1, $2)"
  fn math_random() -> Float = "Math.random()"
  fn math_trunc(x: Float) -> Float = "Math.trunc($1)"
  fn math_sign(x: Float) -> Float = "Math.sign($1)"
  fn math_hypot(a: Float, b: Float) -> Float = "Math.hypot($1, $2)"
  fn math_cbrt(x: Float) -> Float = "Math.cbrt($1)"
  fn math_pi() -> Float = "Math.PI"
  fn math_e() -> Float = "Math.E"

  // --- JSON ---
  fn json_stringify(val: a) -> Str = "JSON.stringify($1)"
  fn json_parse(s: Str) -> a = "JSON.parse($1)"

  // --- fetch (browser/Node) ---
  fn fetch_(url: Str) !async -> a = "fetch($1)"
  fn response_json(resp: a) !async -> a = "$1.json()"
  fn response_text(resp: a) !async -> Str = "$1.text()"

  // --- fs (Node) ---
  fn fs_readFileSync(path: Str, encoding: Str) !io -> Str = "require('fs').readFileSync($1, $2)"
  fn fs_writeFileSync(path: Str, content: Str) !io = "require('fs').writeFileSync($1, $2)"
  fn fs_existsSync(path: Str) !io -> Bool = "require('fs').existsSync($1)"
  fn fs_mkdirSync(path: Str) !io = "require('fs').mkdirSync($1)"
  fn fs_rmdirSync(path: Str) !io = "require('fs').rmdirSync($1)"
  fn fs_unlinkSync(path: Str) !io = "require('fs').unlinkSync($1)"
  fn fs_renameSync(oldPath: Str, newPath: Str) !io = "require('fs').renameSync($1, $2)"
  fn fs_copyFileSync(src: Str, dest: Str) !io = "require('fs').copyFileSync($1, $2)"
  fn fs_readdirSync(path: Str) !io -> List<Str> = "require('fs').readdirSync($1)"
  fn fs_statSync(path: Str) !io -> a = "require('fs').statSync($1)"
  fn fs_appendFileSync(path: Str, content: Str) !io = "require('fs').appendFileSync($1, $2)"
  fn fs_accessSync(path: Str) !io = "require('fs').accessSync($1)"
  fn fs_readFile(path: Str, encoding: Str) !async -> Str = "require('fs').promises.readFile($1, $2)"
  fn fs_writeFile(path: Str, content: Str) !async = "require('fs').promises.writeFile($1, $2)"

  // --- path (Node) ---
  fn path_join(a: Str, b: Str) -> Str = "require('path').join($1, $2)"
  fn path_resolve(p: Str) -> Str = "require('path').resolve($1)"
  fn path_dirname(p: Str) -> Str = "require('path').dirname($1)"
  fn path_basename(p: Str) -> Str = "require('path').basename($1)"
  fn path_extname(p: Str) -> Str = "require('path').extname($1)"
  fn path_parse(p: Str) -> a = "require('path').parse($1)"
  fn path_format(obj: a) -> Str = "require('path').format($1)"
  fn path_isAbsolute(p: Str) -> Bool = "require('path').isAbsolute($1)"
  fn path_relative(from: Str, to: Str) -> Str = "require('path').relative($1, $2)"
  fn path_normalize(p: Str) -> Str = "require('path').normalize($1)"

  // --- Number ---
  fn number_isNaN(val: a) -> Bool = "Number.isNaN($1)"
  fn number_isFinite(val: a) -> Bool = "Number.isFinite($1)"
  fn number_isInteger(val: a) -> Bool = "Number.isInteger($1)"
  fn number_parseInt(s: Str, radix: Int) -> Int = "Number.parseInt($1, $2)"
  fn number_parseFloat(s: Str) -> Float = "Number.parseFloat($1)"
  fn number_toFixed(n: Float, digits: Int) -> Str = "$1.toFixed($2)"
  fn number_toString(n: Float, radix: Int) -> Str = "$1.toString($2)"

  // --- Error ---
  fn error_new(msg: Str) -> a = "new Error($1)"
  fn error_message(err: a) -> Str = "$1.message"
  fn error_name(err: a) -> Str = "$1.name"
  fn error_stack(err: a) -> Option<Str> = "$1.stack"
}
