// ---------------------------------------------------------------------------
// TypeScript utility type helpers (runtime encodings)
//
// TypeScript utility types (Partial<T>, Readonly<T>, Record<K,V>, Pick<T,K>,
// Omit<T,K>, Required<T>, NonNullable<T>, ReturnType<F>, Parameters<F>) are
// compile-time only and have no runtime representation.  The externs below
// expose the common *runtime* patterns that correspond to those utilities.
// ---------------------------------------------------------------------------

// Readonly — Object.freeze as a shallow Readonly<T> stand-in
@foreign("Object", "freeze", "Object.freeze($1)")
pub extern fn readonlyFreeze(obj: Str) -> Str

// Record<string, V> construction via Object.fromEntries
@foreign("Object", "fromEntries", "Object.fromEntries($1)")
pub extern fn recordFromEntries(pairs: List<Str>) -> Str

// Pick — runtime pick via Object.fromEntries + filter
@foreign("", "pick", "Object.fromEntries(Object.entries($1).filter(([k]) => $2.includes(k)))")
pub extern fn objectPick(obj: Str, keys: List<Str>) -> Str

// Omit — runtime omit via Object.fromEntries + filter
@foreign("", "omit", "Object.fromEntries(Object.entries($1).filter(([k]) => !$2.includes(k)))")
pub extern fn objectOmit(obj: Str, keys: List<Str>) -> Str

// ---------------------------------------------------------------------------
// TypeScript-specific runtime guards
// ---------------------------------------------------------------------------

// typeof checks — emitted directly as JS typeof expressions
@foreign("", "typeofString", "typeof $1 === \"string\"")
pub extern fn isString(val: Str) -> Bool

@foreign("", "typeofNumber", "typeof $1 === \"number\"")
pub extern fn isNumber(val: Str) -> Bool

@foreign("", "typeofBoolean", "typeof $1 === \"boolean\"")
pub extern fn isBoolean(val: Str) -> Bool

@foreign("", "typeofFunction", "typeof $1 === \"function\"")
pub extern fn isFunction(val: Str) -> Bool

@foreign("", "instanceof", "$1 instanceof $2")
pub extern fn instanceOf(val: Str, ctor: Str) -> Bool

