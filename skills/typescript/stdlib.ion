// TypeScript / Node.js standard library extern declarations.
// Module: typescript.stdlib  Version: 0.1.0
//
// TypeScript shares the JS runtime (DOM, Node.js, V8), so most declarations
// are identical to javascript/stdlib.ion.  This file re-exports the full JS
// stdlib surface and adds TS-specific type utilities.
//
// Each declaration maps an Ion name to a runtime API via
// @foreign(module, symbol, template) where $1..$N are positional args.

// ---------------------------------------------------------------------------
// console
// ---------------------------------------------------------------------------

@foreign("console", "log", "console.log($1)")
pub extern fn consoleLog(msg: Str) !io -> Unit

@foreign("console", "error", "console.error($1)")
pub extern fn consoleError(msg: Str) !io -> Unit

@foreign("console", "warn", "console.warn($1)")
pub extern fn consoleWarn(msg: Str) !io -> Unit

@foreign("console", "info", "console.info($1)")
pub extern fn consoleInfo(msg: Str) !io -> Unit

@foreign("console", "debug", "console.debug($1)")
pub extern fn consoleDebug(msg: Str) !io -> Unit

@foreign("console", "assert", "console.assert($1, $2)")
pub extern fn consoleAssert(cond: Bool, msg: Str) !io -> Unit

@foreign("console", "table", "console.table($1)")
pub extern fn consoleTable(tbl: Str) !io -> Unit

@foreign("console", "time", "console.time($1)")
pub extern fn consoleTime(label: Str) !io -> Unit

@foreign("console", "timeEnd", "console.timeEnd($1)")
pub extern fn consoleTimeEnd(label: Str) !io -> Unit

@foreign("console", "clear", "console.clear()")
pub extern fn consoleClear() !io -> Unit

