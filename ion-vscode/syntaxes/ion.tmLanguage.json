{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ion",
  "scopeName": "source.ion",
  "fileTypes": ["ion", "ionw"],
  "patterns": [
    { "include": "#line-comment" },
    { "include": "#block-comment" },
    { "include": "#string" },
    { "include": "#effect" },
    { "include": "#fn-name" },
    { "include": "#type-name" },
    { "include": "#keyword-control" },
    { "include": "#keyword-declaration" },
    { "include": "#builtin-type" },
    { "include": "#constant-language" },
    { "include": "#constant-numeric" },
    { "include": "#variable" }
  ],
  "repository": {
    "line-comment": {
      "name": "comment.line.double-slash.ion",
      "match": "//.*$"
    },
    "block-comment": {
      "name": "comment.block.ion",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "string": {
      "name": "string.quoted.double.ion",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.interpolation.ion",
          "begin": "\\{",
          "end": "\\}"
        }
      ]
    },
    "effect": {
      "name": "support.type.effect.ion",
      "match": "(!io|!async|!llm)\\b"
    },
    "fn-name": {
      "comment": "Matches `fn <name>` so the function name gets entity.name.function scope",
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.ion" },
        "2": { "name": "entity.name.function.ion" }
      }
    },
    "type-name": {
      "comment": "Matches `data <Name>` and `type <Name>` so the type name gets entity.name.type scope",
      "match": "\\b(data|type)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.ion" },
        "2": { "name": "entity.name.type.ion" }
      }
    },
    "keyword-control": {
      "name": "keyword.control.ion",
      "match": "\\b(if|else|match)\\b"
    },
    "keyword-declaration": {
      "name": "keyword.declaration.ion",
      "match": "\\b(fn|let|data|module|use|pub|extern|type)\\b"
    },
    "builtin-type": {
      "name": "storage.type.ion",
      "match": "\\b(Int|Float|Str|Bool|List|Map|Option|Result|Unit)\\b"
    },
    "constant-language": {
      "name": "constant.language.ion",
      "match": "\\b(true|false|null)\\b"
    },
    "constant-numeric": {
      "patterns": [
        {
          "name": "constant.numeric.float.ion",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ion",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "variable": {
      "name": "variable.other.ion",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
