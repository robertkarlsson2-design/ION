{
  "name": "ion-vscode",
  "displayName": "Ion Language",
  "description": "VS Code extension for the Ion programming language",
  "version": "0.1.0",
  "publisher": "ion-lang",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ion"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ion",
        "aliases": ["Ion"],
        "extensions": [".ion", ".ionw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ion",
        "scopeName": "source.ion",
        "path": "./syntaxes/ion.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ion.build",
        "title": "Ion: Build"
      },
      {
        "command": "ion.check",
        "title": "Ion: Check"
      },
      {
        "command": "ion.format",
        "title": "Ion: Format"
      },
      {
        "command": "ion.ingest",
        "title": "Ion: Ingest File"
      }
    ],
    "configuration": {
      "title": "Ion",
      "properties": {
        "ion.serverPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the Ion LSP server. Leave empty to use the bundled server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^2.27.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "package": "vsce package"
  }
}
