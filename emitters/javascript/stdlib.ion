// Javascript / Node.js standard library extern declarations.
// Module: javascript.stdlib  Version: 0.1.0
// Each declaration maps an Ion name to a JS API via @foreign(module, symbol, template).

// ---------------------------------------------------------------------------
// console
// ---------------------------------------------------------------------------

@foreign("console", "log", "console.log($1)")
