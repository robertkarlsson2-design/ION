@foreign("console", "table", "console.table($1)")
pub extern fn consoleTable(tbl: Str) !io -> Unit

@foreign("console", "time", "console.time($1)")
pub extern fn consoleTime(label: Str) !io -> Unit

@foreign("console", "timeEnd", "console.timeEnd($1)")
pub extern fn consoleTimeEnd(label: Str) !io -> Unit

@foreign("console", "clear", "console.clear()")
pub extern fn consoleClear() !io -> Unit

